# Neon Postgres connection string (Dashboard → Connection Details → pooled)
DATABASE_URL="postgresql://user:password@host.neon.tech/trueapply?sslmode=require"

# Public site URL, used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Clerk (Dashboard → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL="/onboarding"

# Groq (free tier) for the ghost-job description check
GROQ_API_KEY="gsk_..."
GROQ_MODEL="openai/gpt-oss-120b"

# Shared secret for the job-expiry cron route
CRON_SECRET="random-string"
